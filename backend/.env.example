# Database — replace with your local/hosted Postgres connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/abyss_erp_db?schema=public"
DIRECT_URL=
# Server
PORT=5000
NODE_ENV=development
APP_URL="http://localhost:5173"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Email (used to send login credentials to employees created by an admin)
# Gmail: enable 2-Step Verification, then generate an "App Password" at
# https://myaccount.google.com/apppasswords — use that here, not your real password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="AbyssERP <your-gmail-address@gmail.com>"
